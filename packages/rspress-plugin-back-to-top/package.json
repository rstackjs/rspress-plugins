{
  "name": "rspress-plugin-back-to-top",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "description": "Rspress plugin that add a back to top button to your site.",
  "type": "module",
  "keywords": [
    "rspress",
    "plugin",
    "back-to-top"
  ],
  "homepage": "https://github.com/rstackjs/rspress-plugins/tree/main/packages/rspress-plugin-back-to-top#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rspress-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rspress-plugins.git",
    "directory": "packages/rspress-plugin-back-to-top"
  },
  "license": "MIT",
  "author": "Linbudu <linbudu599@gmail.com> (https://github.com/linbudu599)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "docs:build": "rs doc build",
    "docs:dev": "concurrently --kill-others --names lib,doc \"rs lib -w\" \"rs doc\""
  },
  "dependencies": {
    "rspress-plugin-devkit": "workspace:^",
    "throttle-debounce": "^5.0.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-less": "catalog:",
    "@rspress/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/throttle-debounce": "^5.0.2",
    "react": "catalog:",
    "rspress-plugin-back-to-top": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.0-rc.4 || ^2.0.0"
  }
}
