{
  "name": "rspress-plugin-third-parties",
  "version": "2.1.2",
  "description": "Optimized third-party components (YouTube, Google Maps, Twitter/X, GA) and script loading strategies for Rspress.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "docs:build": "rs doc build",
    "docs:dev": "concurrently --kill-others --names lib,doc \"rs lib -w\" \"rs doc\""
  },
  "keywords": [
    "rspress",
    "rspress-plugin",
    "react",
    "analytics",
    "google-analytics",
    "youtube",
    "embed",
    "performance"
  ],
  "author": "Sanjaiyan Parthipan <https://github.com/sanjaiyan-dev>",
  "license": "MIT",
  "homepage": "https://sanjaiyan-dev.github.io/rspress-plugin-third-parties",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rspress-plugins.git",
    "directory": "packages/rspress-plugin-third-parties"
  },
  "bugs": {
    "url": "https://github.com/rstackjs/rspress-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "react-compiler-runtime": "0.0.0-experimental-a1856f3-20260507",
    "react-tweet": "^3.3.1",
    "third-party-capital": "^3.0.0"
  },
  "peerDependencies": {
    "@rspress/core": ">=2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "catalog:",
    "@rspress/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^18.3.7",
    "babel-plugin-react-compiler": "0.0.0-experimental-a1856f3-20260507",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-render-to-markdown": "^18.3.1",
    "rspress-plugin-third-parties": "workspace:*",
    "typescript": "catalog:"
  }
}
