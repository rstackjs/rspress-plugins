{
  "name": "rspress-plugin-align-image",
  "version": "1.0.0",
  "description": "Rspress plugin for aligning images",
  "type": "module",
  "keywords": [
    "rspress",
    "plugin",
    "align",
    "image"
  ],
  "homepage": "https://github.com/rstackjs/rspress-plugins/tree/main/packages/rspress-plugin-align-image#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rspress-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rspress-plugins.git",
    "directory": "packages/rspress-plugin-align-image"
  },
  "license": "MIT",
  "author": "Linbudu <linbudu599@gmail.com> (https://github.com/linbudu599)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "docs:build": "rs doc build",
    "docs:dev": "concurrently --kill-others --names lib,doc \"rs lib -w\" \"rs doc\""
  },
  "dependencies": {
    "rspress-plugin-devkit": "workspace:^"
  },
  "devDependencies": {
    "@rspress/core": "catalog:",
    "@types/node": "catalog:",
    "rspress-plugin-align-image": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.0-rc.4 || ^2.0.0"
  }
}
