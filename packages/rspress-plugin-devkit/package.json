{
  "name": "rspress-plugin-devkit",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "description": "Rspress plugin develop kit.",
  "keywords": [
    "rspress",
    "plugin",
    "devkit"
  ],
  "homepage": "https://github.com/rstackjs/rspress-plugins/tree/main/packages/rspress-plugin-devkit#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rspress-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rspress-plugins.git",
    "directory": "packages/rspress-plugin-devkit"
  },
  "license": "MIT",
  "author": "Linbudu <linbudu599@gmail.com> (https://github.com/linbudu599)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
