{
  "name": "rspress-plugin-katex",
  "version": "1.0.1",
  "description": "Rspress plugin to render math with KaTeX",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "rspress",
    "plugin",
    "katex"
  ],
  "homepage": "https://github.com/rstackjs/rspress-plugins/tree/main/packages/rspress-plugin-katex#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rspress-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rspress-plugins.git",
    "directory": "packages/rspress-plugin-katex"
  },
  "license": "MIT",
  "author": "Linbudu <linbudu599@gmail.com> (https://github.com/linbudu599)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "docs:build": "rs doc build",
    "docs:dev": "concurrently --kill-others --names lib,doc \"rs lib -w\" \"rs doc\""
  },
  "dependencies": {
    "katex": "^0.16.10",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "rspress-plugin-devkit": "workspace:^",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@rspress/core": "catalog:",
    "@types/node": "catalog:",
    "rspress-plugin-katex": "workspace:*",
    "typescript": "catalog:",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.0-rc.4 || ^2.0.0"
  }
}
